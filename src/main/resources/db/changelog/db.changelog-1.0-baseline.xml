<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1-current-schema" author="holonet-bridge">
        <createTable tableName="holonet_support_channel">
            <column name="channel_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="guild_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="requester_user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="number" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="connection_id" type="UUID"/>
            <column name="ticket_id" type="VARCHAR(255)"/>
            <column name="ticket_url" type="VARCHAR(2048)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="holonet_support_channel" indexName="idx_holonet_support_channel_connection_ticket">
            <column name="connection_id"/>
            <column name="ticket_id"/>
        </createIndex>

        <createTable tableName="holonet_guild_sequence">
            <column name="guild_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="current_number" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createSequence sequenceName="holonet_bot_interaction_session_seq" startValue="1" incrementBy="1"/>
        <createTable tableName="holonet_bot_interaction_session">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="locale" type="VARCHAR(255)"/>
            <column name="guild_id" type="BIGINT"/>
            <column name="channel_id" type="BIGINT"/>
            <column name="member_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="closed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <createIndex tableName="holonet_bot_interaction_session" indexName="idx_holonet_interaction_session_lookup">
            <column name="guild_id"/>
            <column name="member_id"/>
            <column name="channel_id"/>
            <column name="closed_at"/>
        </createIndex>

        <createSequence sequenceName="holonet_setup_form_data_seq" startValue="1" incrementBy="1"/>
        <createTable tableName="holonet_setup_form_data">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="session_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_holonet_setup_form_data_session"/>
            </column>
            <column name="ticket_provider" type="VARCHAR(32)"/>
            <column name="base_url" type="VARCHAR(255)"/>
            <column name="target" type="VARCHAR(255)"/>
            <column name="token" type="VARCHAR(2048)"/>
            <column name="support_channel_id" type="BIGINT"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="holonet_setup_form_data"
                baseColumnNames="session_id"
                constraintName="fk_holonet_setup_form_data_session"
                referencedTableName="holonet_bot_interaction_session"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
