<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="8-setup-ticket-provider-and-target" author="holonet-bridge">
        <addColumn tableName="holonet_setup_form_data">
            <column name="ticket_provider" type="VARCHAR(32)"/>
            <column name="target" type="VARCHAR(255)"/>
            <column name="support_channel_id" type="BIGINT"/>
        </addColumn>
        <modifyDataType tableName="holonet_setup_form_data" columnName="token" newDataType="VARCHAR(2048)"/>
        <sql>
            UPDATE holonet_setup_form_data
            SET target = CONCAT(owner, '/', repository)
            WHERE owner IS NOT NULL AND repository IS NOT NULL
        </sql>
    </changeSet>

</databaseChangeLog>
